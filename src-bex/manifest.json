{
  "all": {
    "manifest_version": 3,
    "icons": {
      "16": "icons/icon-16x16.png",
      "48": "icons/icon-48x48.png",
      "128": "icons/icon-128x128.png"
    },
    "permissions": [
      "storage"
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval' http://localhost:* http://127.0.0.1:*; object-src 'self';"
    },
    "browser_specific_settings": {
      "gecko": {
        "id": "@diogel",
        "strict_min_version": "115.0",
        "data_collection_permissions": {
          "required": [
            "none"
          ]
        }
      }
    },
    "web_accessible_resources": [
      {
        "resources": [
          "assets/**/**",
          "nostr-provider.js",
          "www/images/**"
        ],
        "matches": [
          "*://*/*"
        ]
      }
    ],
    "action": {
      "default_title": "Porwr"
    },
    "content_scripts": [
      {
        "matches": [
          "<all_urls>"
        ],
        "css": [
          "assets/content.css"
        ],
        "js": [
          "content-script.ts"
        ],
        "run_at": "document_end"
      }
    ]
  },
  "chrome": {
    "background": {
      "service_worker": "background.ts"
    },
    "permissions": [
      "sidePanel"
    ],
    "side_panel": {
      "default_path": "www/index.html#/sidebar"
    }
  },
  "firefox": {
    "background": {
      "scripts": [
        "background.ts"
      ]
    },
    "sidebar_action": {
      "default_title": "Porwr",
      "default_panel": "www/index.html#/sidebar",
      "default_icon": {
        "16": "icons/icon-16x16.png",
        "48": "icons/icon-48x48.png",
        "128": "icons/icon-128x128.png"
      }
    }
  }
}
