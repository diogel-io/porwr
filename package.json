{
  "name": "diogel",
  "version": "0.3.2",
  "description": "Privacy focused nostr extension",
  "productName": "Porwr",
  "author": "threenine.io <support@threenine.co.uk>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "dev": "quasar dev -m bex -T chrome",
    "build": "quasar build",
    "postinstall": "quasar prepare",
    "build:chrome": "quasar build -m bex -T chrome",
    "build:firefox": "quasar build -m bex -T firefox",
    "test:e2e": "npm run build:chrome && playwright test --project=chromium",
    "test:e2e:only": "playwright test",
    "test:e2e:firefox": "npm run build:firefox && playwright test --project=firefox",
    "test:e2e:all": "npm run build:chrome && npm run build:firefox && playwright test",
    "record:sidebar": "npm run build:chrome && playwright test --config tests/recordings/playwright.config.ts"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@quasar/extras": "^2.1.0",
    "@scure/base": "^2.4.0",
    "dexie": "^4.4.7",
    "nostr-tools": "^2.25.5",
    "pinia": "^3.0.4",
    "quasar": "^2.35.2",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.64.1",
    "@quasar/app-vite": "^3.10.3",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.6.6",
    "@types/selenium-webdriver": "^4.35.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "geckodriver": "^6.1.1",
    "globals": "^16.5.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "selenium-webdriver": "^4.51.0",
    "typescript": "^5.9.3",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^4.1.12",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14",
    "ws": "^8.22.1"
  },
  "engines": {
    "node": "^22.22 || ^24 || ^26 || ^28"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "geckodriver@6.1.1": true,
    "@parcel/watcher": false
  }
}
